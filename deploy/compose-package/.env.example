# 知识产权归甲方所有（COM-IP-01）——AI 外贸销售智能体系统交付物。
# .env 模板（FR-SAAS-004，SR-SAAS-004 §6.2/§6.5）——由 gen_config.py 生成，禁止手改；
# 本文件为示例模板（展示依赖清单钉版与密钥占位口径）。生产部署时：
#   python3 tools/saas/gen_config.py -c tenant-config.example.yaml --target compose --out .env
# 镜像 tag 一律版本化不可变（浮动标签禁用）；依赖清单（SBOM 源）钉版随包交付（COM-IP-05）。

# ── 应用镜像（gen-config 生成段）──
IMAGE_REGISTRY=registry.example.com
IMAGE_TAG=1.0.0-GENERATED-BY-GEN-CONFIG
TENANT_ID=t001
TENANT_PLAN=standard
PUBLIC_DOMAIN=sale.example.com

# ── 数据层依赖清单（钉版，许可证结论见 docs-product/deploy-guide.md §依赖与合规）──
IMAGE_POSTGRES=postgres:16.4          # PostgreSQL License，无传染
IMAGE_REDIS=redis:7.2                 # RSALv2/SSPL——未修改容器镜像使用合规
IMAGE_MILVUS=milvusdb/milvus:v2.4.17  # Apache-2.0
IMAGE_TEI=tei-bge-m3:1.6.0            # BGE-M3 本地部署（数据不出内网），Apache-2.0
PG_SIZE_GB=100
MILVUS_SIZE_GB=200
REDIS_SIZE_GB=20

# ── 密钥占位（bootstrap 第②步随机生成落 .secrets/，600 权限，不入 Git，NFR-SEC-04）──
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_BOOTSTRAP
REDIS_PASSWORD=CHANGE_ME_GENERATED_BY_BOOTSTRAP
JWT_SALT=CHANGE_ME_GENERATED_BY_BOOTSTRAP
DEEPSEEK_API_KEY=CHANGE_ME_CUSTOMER_PROVIDED   # 甲方自备（数据边界 NFR-SEC-06）
